#include <stdio.h>
#include <time.h>
#include <windows.h>

void LinearSearch(int a[], int key, int num)
{
    for(int i = 0; i < num; i++)
    {
        Sleep(1);

        if(a[i] == key)
        {
            printf("\nKey = %d found at index %d", key, i);
            return;
        }
    }

    printf("\nUnsuccessful search");
}

int main()
{
    clock_t beg, end;
    int a[50], key;
    int n[] = {10, 20, 30, 40, 50};

    for(int j = 0; j < 5; j++)
    {
        for(int i = 0; i < n[j]; i++)
            a[i] = i + 1;

        key = n[j];

        beg = clock();
        LinearSearch(a, key, n[j]);
        end = clock();

        printf("\nTime = %.3f milliseconds\n",
               (double)(end - beg) / CLOCKS_PER_SEC * 1000);
    }

    return 0;
}
